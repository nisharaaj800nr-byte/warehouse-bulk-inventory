    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}
