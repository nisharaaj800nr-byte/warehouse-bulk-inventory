{
  "name": "bulk-repair-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bulk Repair — inventory operations portal (React) for the Apps Script backend",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
